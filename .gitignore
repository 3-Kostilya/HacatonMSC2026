# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Environment
.env

# Incoming data
data/incoming/*
!data/incoming/.gitkeep

# Processed data
data/processed/*
!data/processed/.gitkeep

# Failed imports
data/failed/*
!data/failed/.gitkeep

# Runtime Parquet storage
data/store/*.parquet

data/store/events/*.parquet
!data/store/events/.gitkeep

data/store/forecasts/*.parquet
!data/store/forecasts/.gitkeep

data/store/episodes/*.parquet
!data/store/episodes/.gitkeep